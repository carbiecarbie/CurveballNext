diff --git a/core/src/m4.rs b/core/src/m4.rs
new file mode 100644
--- /dev/null
+++ b/core/src/m4.rs
@@ -0,0 +1,329 @@
+//! Local M4 observer. No ActionScript evaluation, getters, queue drains or game writes.
+use crate::avm1::{Object, Value as AvmValue};
+use crate::context::UpdateContext;
+use crate::display_object::{BoundsMode, DisplayObject, TDisplayObject};
+use crate::prelude::TDisplayObjectContainer;
+
+use crate::Player;
+use serde_json::{Value, json};
+use std::sync::{
+    Mutex,
+    atomic::{AtomicBool, AtomicU64, Ordering},
+};
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static DETAIL: AtomicBool = AtomicBool::new(false);
+static ALLOCATION: AtomicU64 = AtomicU64::new(1);
+static TRACE: Mutex<Trace> = Mutex::new(Trace {
+    seq: 0,
+    frame: 0,
+    shift: 0,
+    rows: Vec::new(),
+    writes: std::collections::BTreeMap::new(),
+});
+struct Trace {
+    seq: u64,
+    frame: u64,
+    shift: usize,
+    rows: Vec<Value>,
+    writes: std::collections::BTreeMap<String, u64>,
+}
+pub fn allocation() -> u64 {
+    ALLOCATION.fetch_add(1, Ordering::Relaxed)
+}
+pub fn active() -> bool {
+    ACTIVE.load(Ordering::Relaxed)
+}
+pub fn detail(on: bool) {
+    DETAIL.store(on, Ordering::Relaxed);
+}
+pub fn start(shift: usize) {
+    TRACE.lock().unwrap().shift = shift;
+    ACTIVE.store(true, Ordering::Relaxed);
+}
+pub fn finish(path: &str) {
+    ACTIVE.store(false, Ordering::Relaxed);
+    let trace = TRACE.lock().unwrap();
+    let mut out = std::io::BufWriter::new(std::fs::File::create(path).unwrap());
+    for row in &trace.rows {
+        serde_json::to_writer(&mut out, row).unwrap();
+        std::io::Write::write_all(&mut out, b"\n").unwrap();
+    }
+}
+fn number(v: f64) -> Value {
+    if v.is_nan() {
+        json!({"special":"NaN","bits":format!("{:016x}",v.to_bits())})
+    } else if v == f64::INFINITY {
+        json!({"special":"+Infinity"})
+    } else if v == f64::NEG_INFINITY {
+        json!({"special":"-Infinity"})
+    } else if v == 0.0 && v.is_sign_negative() {
+        json!({"special":"-0"})
+    } else {
+        json!(v)
+    }
+}
+fn scalar(v: AvmValue<'_>) -> Value {
+    match v {
+        AvmValue::Undefined => json!({"special":"undefined"}),
+        AvmValue::Null => Value::Null,
+        AvmValue::Bool(v) => json!(v),
+        AvmValue::Number(v) => number(v),
+        AvmValue::String(v) => json!(v.to_utf8_lossy()),
+        _ => json!({"special":"object-reference-not-resolved"}),
+    }
+}
+fn props(obj: Object<'_>) -> Value {
+    let mut out = serde_json::Map::new();
+    for (key, value) in obj.own_properties() {
+        // Read property.data only; object references and virtual getters are never resolved.
+        if let AvmValue::Object(o) = value {
+            if o.as_function().is_none() && o.as_display_object_no_super().is_none() {
+                let mut nested = serde_json::Map::new();
+                for (k, v) in o.own_properties() {
+                    if !matches!(v, AvmValue::Object(_) | AvmValue::MovieClip(_)) {
+                        nested.insert(k.to_utf8_lossy().to_string(), scalar(v));
+                    }
+                }
+                out.insert(key.to_utf8_lossy().to_string(), Value::Object(nested));
+            }
+        } else if !matches!(value, AvmValue::MovieClip(_)) {
+            out.insert(key.to_utf8_lossy().to_string(), scalar(value));
+        }
+    }
+    Value::Object(out)
+}
+pub(crate) fn clip(d: DisplayObject<'_>) -> Value {
+    let b = d.world_bounds(BoundsMode::Script);
+    let local = d.bounds(BoundsMode::Script);
+    let m = d.base().matrix();
+    json!({"cid":d.id(), "allocation":d.as_movie_clip().map(|c|c.m4_id()),
+        "name":d.name().map(|s|s.to_utf8_lossy().to_string()),
+        "timeline":d.as_movie_clip().map(|c|c.current_frame()),
+        "props":d.object1().map(props),
+        "display":{"x":number(d.x().to_pixels()),"y":number(d.y().to_pixels()),
+            "width":number(d.width()),"height":number(d.height()),
+            "worldTwips":[b.x_min.get(),b.y_min.get(),b.x_max.get(),b.y_max.get()],
+            "localTwips":[local.x_min.get(),local.y_min.get(),local.x_max.get(),local.y_max.get()],
+            "matrix":[m.a as f64,m.b as f64,m.c as f64,m.d as f64,m.tx.get(),m.ty.get()]}})
+}
+fn walk<'gc>(d: DisplayObject<'gc>, list: &mut Vec<Value>) {
+    if matches!(d.id(), 0 | 7 | 59 | 75 | 77 | 80) || d.as_avm1_button().is_some() {
+        list.push(clip(d));
+    }
+    if let Some(c) = d.as_container() {
+        for child in c.iter_render_list() {
+            walk(child, list);
+        }
+    }
+}
+fn snapshot(context: &UpdateContext<'_>) -> Value {
+    let mut list = Vec::new();
+    let mut world = Value::Null;
+    if let Some(root) = context.stage.root_clip() {
+        walk(root, &mut list);
+        if let Some(obj) = root.object1() {
+            for (k, v) in obj.own_properties() {
+                if k.to_utf8_lossy() == "world" {
+                    if let AvmValue::Object(o) = v {
+                        world = props(o);
+                    }
+                }
+            }
+        }
+    }
+    json!({"clips":list,"world":world,"playerVersion":context.player_version})
+}
+pub(crate) fn record(context: &UpdateContext<'_>, kind: &str, data: Value) {
+    if !active() {
+        return;
+    }
+    let state = snapshot(context);
+    let mut t = TRACE.lock().unwrap();
+    t.seq += 1;
+    let row = json!({"seq":t.seq,"frame":t.frame,"kind":kind,"data":data,"state":state});
+    t.rows.push(row);
+}
+pub(crate) fn begin(context: &UpdateContext<'_>) {
+    if !active() {
+        return;
+    }
+    TRACE.lock().unwrap().frame += 1;
+    record(context, "frame-begin", Value::Null);
+}
+pub(crate) fn action(
+    context: &UpdateContext<'_>,
+    phase: &str,
+    d: DisplayObject<'_>,
+    start: usize,
+    end: usize,
+) {
+    if !active() {
+        return;
+    }
+    let shift = TRACE.lock().unwrap().shift;
+    record(
+        context,
+        phase,
+        json!({"clip":clip(d),"bufferStart":start,"originalStart":start+shift,"originalEnd":end+shift}),
+    );
+}
+pub(crate) fn instruction(
+    context: &UpdateContext<'_>,
+    d: DisplayObject<'_>,
+    start: usize,
+    position: usize,
+) {
+    if !active() || !DETAIL.load(Ordering::Relaxed) {
+        return;
+    }
+    let shift = TRACE.lock().unwrap().shift;
+    let absolute = position + shift;
+    if (0x8636..0x8c79).contains(&absolute)
+        || (0xa5b0..0xb02f).contains(&absolute)
+        || (0xb787..0xdef0).contains(&absolute)
+    {
+        record(
+            context,
+            "instruction-before",
+            json!({"cid":d.id(),"allocation":d.as_movie_clip().map(|c|c.m4_id()),"bufferStart":start,"bufferOffset":position,"originalOffset":absolute}),
+        );
+    }
+}
+pub(crate) fn field(
+    _context: &UpdateContext<'_>,
+    op: &str,
+    namespace: String,
+    name: &str,
+    value: AvmValue<'_>,
+) {
+    if !active() {
+        return;
+    }
+    if !(name.starts_with("paddle")
+        || name.starts_with("enemy")
+        || name.starts_with("ballPos")
+        || name.starts_with("ballDir")
+        || matches!(
+            name,
+            "pPosX" | "pPosY" | "pSpeedX" | "pSpeedY" | "ePosX" | "ePosY" | "eSpeedX" | "eSpeedY"
+        ))
+    {
+        return;
+    }
+    let mut t = TRACE.lock().unwrap();
+    t.seq += 1;
+    let seq = t.seq;
+    let key = format!("{namespace}:{name}");
+    let source = t.writes.get(&key).copied();
+    if op == "write" {
+        t.writes.insert(key, seq);
+    }
+    let row = json!({"seq":seq,"frame":t.frame,"kind":format!("field-{op}"),"data":{"namespace":namespace,"name":name,"value":scalar(value),"sourceWriteSeq":source},"state":null});
+    t.rows.push(row);
+}
+pub(crate) fn variable(
+    context: &UpdateContext<'_>,
+    op: &str,
+    d: DisplayObject<'_>,
+    name: &str,
+    value: AvmValue<'_>,
+) {
+    field(
+        context,
+        op,
+        format!(
+            "clip:{}:{}",
+            d.id(),
+            d.as_movie_clip().map(|c| c.m4_id()).unwrap_or(0)
+        ),
+        name,
+        value,
+    );
+}
+pub fn mark(player: &mut Player, label: &str) {
+    player.mutate_with_update_context(|c| record(c, "mark", json!({"label":label})));
+}
+// Fixture preparation is deliberately separate from every observational path.
+// All writes are raw stored fields or native display setters and are logged in full.
+pub fn inject(player: &mut Player, fixture: &Value) {
+    use crate::avm1::Attribute;
+    player.mutate_with_update_context(|c| {
+        record(c, "fixture-before", fixture.clone());
+        let root = c.stage.root_clip().unwrap();
+        let mut clips = Vec::new();
+        fn collect<'gc>(d: DisplayObject<'gc>, out: &mut Vec<DisplayObject<'gc>>) {
+            out.push(d);
+            if let Some(container) = d.as_container() {
+                for child in container.iter_render_list() {
+                    collect(child, out);
+                }
+            }
+        }
+        collect(root, &mut clips);
+        for write in fixture.as_array().unwrap() {
+            let cid = write["cid"].as_u64().unwrap() as u16;
+            let d = *clips
+                .iter()
+                .find(|d| d.id() == cid)
+                .expect("fixture clip absent");
+            let mut obj = d.object1().unwrap();
+            if write["world"].as_bool() == Some(true) {
+                obj = obj
+                    .own_properties()
+                    .into_iter()
+                    .find_map(|(k, v)| {
+                        if k.to_utf8_lossy() == "world" {
+                            if let AvmValue::Object(o) = v {
+                                return Some(o);
+                            }
+                        }
+                        None
+                    })
+                    .expect("world absent");
+            }
+            if let Some(target) = write["object"].as_str() {
+                obj = obj
+                    .own_properties()
+                    .into_iter()
+                    .find_map(|(k, v)| {
+                        if k.to_utf8_lossy() == target {
+                            if let AvmValue::Object(o) = v {
+                                return Some(o);
+                            }
+                        }
+                        None
+                    })
+                    .expect("fixture nested object absent");
+            }
+            if let Some(fields) = write["fields"].as_object() {
+                for (k, v) in fields {
+                    let value = if let Some(n) = v.as_f64() {
+                        AvmValue::Number(n)
+                    } else if v["special"] == "undefined" {
+                        AvmValue::Undefined
+                    } else {
+                        panic!("unsupported fixture value")
+                    };
+                    let name = crate::string::AvmString::new_utf8(c.gc(), k);
+                    obj.define_value(c.gc(), name, value, Attribute::empty());
+                }
+            }
+            if let Some(display) = write["display"].as_object() {
+                if let Some(x) = display.get("x") {
+                    d.set_x(swf::Twips::from_pixels(x.as_f64().unwrap()));
+                }
+                if let Some(y) = display.get("y") {
+                    d.set_y(swf::Twips::from_pixels(y.as_f64().unwrap()));
+                }
+                if let Some(w) = display.get("width") {
+                    d.set_width(c, w.as_f64().unwrap());
+                }
+                if let Some(h) = display.get("height") {
+                    d.set_height(c, h.as_f64().unwrap());
+                }
+            }
+        }
+        record(c, "fixture-after", fixture.clone());
+    });
+}
diff --git a/core/examples/m4_capture.rs b/core/examples/m4_capture.rs
new file mode 100644
--- /dev/null
+++ b/core/examples/m4_capture.rs
@@ -0,0 +1,71 @@
+use ruffle_core::{
+    LoadBehavior, PlayerBuilder,
+    events::{MouseButton, PlayerEvent},
+    m4,
+    tag_utils::movie_from_path,
+};
+use serde_json::{Value, json};
+fn main() {
+    let args: Vec<_> = std::env::args().collect();
+    assert_eq!(
+        args.len(),
+        4,
+        "m4_capture <unchanged.swf> <driver.json> <trace.jsonl>"
+    );
+    let raw = std::fs::read(&args[1]).unwrap();
+    let movie = movie_from_path(&args[1], None).unwrap();
+    assert!(
+        raw.ends_with(movie.data()),
+        "runtime buffer must be exact suffix of verified FWS"
+    );
+    let shift = raw.len() - movie.data().len();
+    m4::start(shift);
+    let player = PlayerBuilder::new()
+        .with_movie(movie)
+        .with_autoplay(true)
+        .with_load_behavior(LoadBehavior::Blocking)
+        .with_viewport_dimensions(350, 250, 1.0)
+        .build();
+    let mut player = player.lock().unwrap();
+    m4::mark(
+        &mut player,
+        &format!("buffer-calibration:{shift};headless-null-backends;normal-frame-driver"),
+    );
+    let steps: Value = serde_json::from_slice(&std::fs::read(&args[2]).unwrap()).unwrap();
+    for step in steps.as_array().unwrap() {
+        match step["op"].as_str().unwrap() {
+            "frames" => {
+                m4::detail(step["detail"].as_bool().unwrap_or(false));
+                for _ in 0..step["n"].as_u64().unwrap() {
+                    player.run_frame();
+                }
+            }
+            "mark" => m4::mark(&mut player, step["label"].as_str().unwrap()),
+            "inject" => m4::inject(&mut player, &step["writes"]),
+            "move" | "down" | "up" => {
+                let x = step["x"].as_f64().unwrap();
+                let y = step["y"].as_f64().unwrap();
+                m4::detail(step["detail"].as_bool().unwrap_or(false));
+                m4::mark(&mut player, &format!("host-arrival:{}:{x}:{y}", step["op"]));
+                let event = match step["op"].as_str().unwrap() {
+                    "move" => PlayerEvent::MouseMove { x, y },
+                    "down" => PlayerEvent::MouseDown {
+                        x,
+                        y,
+                        button: MouseButton::Left,
+                        index: None,
+                    },
+                    _ => PlayerEvent::MouseUp {
+                        x,
+                        y,
+                        button: MouseButton::Left,
+                    },
+                };
+                player.handle_event(event);
+                m4::mark(&mut player, "host-dispatch-returned");
+            }
+            _ => panic!("unsupported driver operation: {}", json!(step)),
+        }
+    }
+    m4::finish(&args[3]);
+}
